# Copy to `.env.local` at the monorepo root (see README).
# Next.js loads this file from both `apps/public` and `apps/dashboard` via next.config.

# --- Public app URL (dashboard talks to this API in local dev) ---
# Default: http://localhost:3002 (see apps/public `package.json` dev script)
NEXT_PUBLIC_PUBLIC_APP_ORIGIN=http://localhost:3002

# --- Optional: override API base for split deployments ---
# If unset: public app uses same origin + `/api`; dashboard uses NEXT_PUBLIC_PUBLIC_APP_ORIGIN + `/api`.
# NEXT_PUBLIC_FEEDCHAT_API_URL=https://your-public-host.example.com/api

# --- Firebase (client-friendly keys for authentication of dashboard) ---
# Currently, Feedchat integrates with Firebase for authentication and data storage.
# The below keys (prefixed NEXT_PUBLIC) are public, and can be exposted to the client. 
# To create these keys: 
# 1. Go to https://console.firebase.google.com/
# 2. Create new project, or open existing project
# 3. Follow instructions to create app, or go to 'Settings' -> 'General' for existing projects
# 4. Create or access Web App for your project
# 5. You will be able to see the keys below on your Firebase console:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Service Account (server-side secrets for storing chat data) ---
# The below keys are sensitive and should never be exposed publicly. 
# They are only ever used server-side in this code. 
# These keys are required to allow the /api to interact with Firebase
# To access the following keys, you need to:
# 1. Open your project in Firebase
# 2. Go to 'Settings' -> 'Service Accounts'
# 3. Click 'Generate new private key'
# 4. Open the key file
# 5. You will be able to see the keys below: 
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
# Note: for FIREBASE_PRIVATE_KEY, you need to paste the entire value, including the "-----BEGIN PRIVATE KEY-----\n at the beginning and \n-----END PRIVATE KEY-----\n" at end.

# --- Chat proxy / internal JWT (public app `/api/chat`) ---
# Optional in dev (defaults to `dev-internal-jwt-secret`); strongly recommended in production.
# INTERNAL_JWT_SECRET=

# --- Server: CORS (Express global middleware) ---
# In production, allow your dashboard origin. Example (escape backslashes in .env):
#FEEDCHAT_ALLOWED_ORIGIN_REGEX=^https://dashboard\\.example\\.com$

# --- OpenAI secrets ---
# For powering Feedchat realtime responses:
OPENAI_API_KEY=
# For chat summarisation and sentiment scoring:
OPENAI_SUMMARY_KEY=
