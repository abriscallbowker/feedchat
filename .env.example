# Copy to `.env.local` at the monorepo root (see README).
# Next.js loads this file from both `apps/public` and `apps/dashboard` via next.config.

# --- Public app URL (dashboard talks to this API in local dev) ---
# Default: http://localhost:3002 (see apps/public `package.json` dev script)
NEXT_PUBLIC_PUBLIC_APP_ORIGIN=http://localhost:3002

# --- Optional: override API base for split deployments ---
# If unset: public app uses same origin + `/api`; dashboard uses NEXT_PUBLIC_PUBLIC_APP_ORIGIN + `/api`.
# NEXT_PUBLIC_FEEDCHAT_API_URL=https://your-public-host.example.com/api

# --- Firebase (client-friendly keys for authentication of dashboard) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Service Account (server-side secrets for storing chat data) ---
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=

# --- Chat proxy / internal JWT (public app `/api/chat`) ---
# Optional in dev (defaults to `dev-internal-jwt-secret`); strongly recommended in production.
# INTERNAL_JWT_SECRET=

# --- Server: CORS (Express global middleware) ---
# In production, allow your dashboard origin. Example (escape backslashes in .env):
# FEEDCHAT_ALLOWED_ORIGIN_REGEX=^https://dashboard\\.example\\.com$

# --- OpenAI secrets ---
OPENAI_API_KEY=
OPENAI_SUMMARY_KEY=
