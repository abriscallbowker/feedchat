modules = ["nodejs-24", "postgresql-16"]

[deployment]
deploymentTarget = "autoscale"

[deployment.build]
args = ["pnpm", "--filter", "@workspace/api-server", "run", "build"]

[deployment.build.env]
NODE_ENV = "production"
CI = "true"

[deployment.run]
args = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]

[deployment.run.env]
NODE_ENV = "production"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
STRIPE_ENV = "live"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[nix]
channel = "stable-25_05"
